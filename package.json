{
  "name": "new",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "backup": "node --env-file-if-exists=.env scripts/backup-postgres.mjs",
    "restore": "node --env-file-if-exists=.env scripts/restore-postgres.mjs",
    "monitoring:setup": "node scripts/setup-monitoring.mjs",
    "monitoring:up": "docker compose --env-file .env --env-file .env.monitoring up -d --build",
    "monitoring:down": "docker compose --env-file .env --env-file .env.monitoring down",
    "lint": "oxlint",
    "test": "node --test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@prometheus-io/client": "^0.16.1",
    "express": "^5.2.1",
    "lucide-react": "^1.51.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
