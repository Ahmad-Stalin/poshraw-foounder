POSHRAW_ADMIN_SETUP_TOKEN=replace-with-a-long-random-secret
POSHRAW_ALLOWED_ORIGINS=https://poshraw.com,https://www.poshraw.com

# Leave DATABASE_URL empty for local PGlite. Set it to the managed PostgreSQL URL in production.
DATABASE_URL=
DATABASE_SSL=require
DATABASE_POOL_SIZE=10

# Optional transactional order email notifications. Without SMTP settings, emails stay queued.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Required for encrypted PostgreSQL backups; keep this key separate from backup storage.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=backups

# Production reverse-proxy settings. Set the number of trusted proxy hops for your host.
API_HOST=0.0.0.0
API_PORT=3001
TRUST_PROXY_HOPS=1
